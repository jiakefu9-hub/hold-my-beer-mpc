# COPY THIS FILE; do not run it as-is.
# Numeric values below are conservative software-envelope examples, not Unitree
# limits and not target-robot approvals. Every value must be reviewed on site.
schema=g1_arm_static_site_v2
synthetic_fixture=false
robot_id=UNSET
model_name=UNSET
joint_layout=g1_23_arm5
confirmed_by=UNSET
loco_service=sport
profile_status=DRAFT

hardware_identity_confirmed=false
mapping_confirmed=false
weight_scope_confirmed=false
invalid_slots_confirmed=false
locked_stand_mode_confirmed=false
# Review procedures before the FIRST small hoisted trial; do not claim that
# hardware release/watchdog tests have already passed. See PRETEST_REVIEW.md.
# Loss plan: assume old output may persist; independent operator stop, no
# auto-resume/reconnect; stop processes and re-establish safe state before retry.
loss_response_plan_reviewed=false
# Review ramp-to-zero code/preview and the operator fallback if release fails.
# Actual smooth hand-back is an outcome to record during A2, not a prerequisite.
normal_release_plan_reviewed=false
emergency_procedure_confirmed=false
no_competing_user_publishers_confirmed=false
safety_parameters_confirmed=false

# Raw values only. Do not label them as a mode until target documentation agrees.
